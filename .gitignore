.conda/
envs/

# PyCharm
.idea/

# VSCode
.vscode/

# pytest
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Logs
logs/
*.log

# Temporary files
temp/
tmp/
*.tmp

# Audio files (optional - remove if you want to commit test audio)
*.wav
*.mp3
*.flac
*.m4a
*.ogg
*.aac

# Models (diese sind groß und sollten nicht committed werden)
resources/models/*
!resources/models/.gitkeep

# OS
.DS_Store
Thumbs.db

# User settings
.env
config_local.py
user_settings.json

# PyInstaller / Packaging
# Note: .spec files ARE tracked (they're build configuration)
dist/
build/
*.app
packaging/icon.icns
packaging/dmg/background.png

# Swift build artifacts
packaging/screencapture_tool/.build/
packaging/screencapture_tool/ScreenCaptureRecorder.app

# BeatNet service build artifacts
packaging/beatnet_service/dist/
packaging/beatnet_service/build/

# Runtime files
.stemseparator.lock
*.lock

# Vendored third-party binaries (fetched at build time; see docs/PACKAGING.md).
# WHY ignored: ~150 MB of ffmpeg/PortAudio binaries do not belong in git;
# the specs reference this layout and a fetch step recreates it.
packaging/vendor/linux/
packaging/vendor/windows/
packaging/vendor/bin/
!packaging/vendor/README*

# Throwaway verification scaffolding for the Linux/Windows port (not tests).
.port_checkpoints/

# Model cache that landed in the tree during development
resources/models/

# Experimental/unfinished features
potential_features/

# Claude Code settings
.claude/
